{
  "name": "forbidden-requiem-launcher",
  "version": "1.0.0",
  "description": "Custom Dark Fantasy Minecraft 1.7.10 Launcher for Forbidden Requiem Modpack",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "generate-manifest": "node tools/generate-manifest.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "forge",
    "modpack",
    "dark-fantasy",
    "forbidden-requiem"
  ],
  "author": "Forbidden Requiem Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.forbiddenrequiem.launcher",
    "productName": "Forbidden Requiem Launcher",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    }
  }
}
