{
  "name": "forbidden-requiem-launcher",
  "version": "1.1.3",
  "description": "Custom Dark Fantasy Minecraft 1.7.10 Launcher for Forbidden Requiem Modpack",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "generate-manifest": "node tools/generate-manifest.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "forge",
    "modpack",
    "dark-fantasy",
    "forbidden-requiem"
  ],
  "author": "Forbidden Requiem Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.forbiddenrequiem.launcher",
    "productName": "Forbidden Requiem Launcher",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Forbidden Requiem Launcher",
      "installerLanguages": [
        "pt_BR"
      ],
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1046",
      "include": "build/installer.nsh"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}